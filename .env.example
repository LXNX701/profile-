# Required for persistent Supabase cache/search logging
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer the new Supabase Secret key for server-side use
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY

# Optional legacy alternative
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional provider/cache settings
FF_UPSTREAM=https://free-ff-api-src-5plp.onrender.com
CACHE_TTL_MS=300000
FF_TIMEOUT_MS=15000
SEARCH_HASH_SALT=CHANGE_THIS_TO_A_RANDOM_VALUE
